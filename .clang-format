BasedOnStyle: Google
# 使用 clang-format 23 或更新版本，VS Code 使用同一个本地程序。
IndentWidth: 4
ContinuationIndentWidth: 4
UseTab: Never
ColumnLimit: 100
AccessModifierOffset: -4
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never

# 命名空间闭合注释统一采用英文格式。
FixNamespaceComments: true

# 使用固定续行缩进，避免按较长的函数名对齐。
AlignAfterOpenBracket: false
PenaltyBreakBeforeFirstCallParameter: 0

# 短调用紧凑排列，较长的实参和形参列表展开。
PackArguments:
  BinPack: OnePerLine
PackParameters:
  BinPack: OnePerLine
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true

# 多行 Error 和 InboxItem 初始化列表的起止括号分别独占一行。
BreakAfterOpenBracketBracedList: true
BreakBeforeCloseBracketBracedList: true

# SQL 文本参与数据库结构比较，禁止重新格式化。
RawStringFormats: []
